/* Fenix NAS Forensic - Estilos de Consola Fraccionada */
:root {
  --bg: #0f131a;
  --panel: #171d28;
  --card: #1e2635;
  --text: #e6edf7;
  --muted: #9aa7bd;
  --accent: #38bdf8;
  --ok: #22c55e;
  --warn: #f59e0b;
  --err: #ef4444;
  --border: #2b364b;
}

* {
  box-sizing: border-box;
  font-family: system-ui, -apple-system, sans-serif;
}

body {
  margin: 0;
  background: var(--bg);
  color: var(--text);
  padding: 16px;
}

header {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  align-items: center;
  gap: 12px;
  margin-bottom: 16px;
}

h1 {
  margin: 0;
  font-size: 1.25rem;
}

.sub {
  color: var(--muted);
  font-size: 0.85rem;
}

.endpoint-bar {
  display: flex;
  gap: 8px;
  align-items: center;
  flex-wrap: wrap;
}

input,
button {
  background: var(--card);
  color: var(--text);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 8px 12px;
  font-size: 0.9rem;
}

button {
  cursor: pointer;
  font-weight: 600;
}

button:hover {
  border-color: var(--accent);
}

button.primary {
  background: #0284c7;
  border-color: #38bdf8;
}

.grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 14px;
  margin-bottom: 16px;
}

.tool-card {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.tool-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.tool-title {
  font-weight: 700;
  font-size: 1rem;
}

.tag {
  font-size: 0.72rem;
  padding: 3px 8px;
  border-radius: 999px;
  background: var(--card);
  color: var(--accent);
  border: 1px solid var(--border);
}

.notif-box {
  background: var(--panel);
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 14px;
}

.notif-list {
  display: flex;
  flex-direction: column;
  gap: 8px;
  max-height: 280px;
  overflow-y: auto;
  margin-top: 10px;
}

.notif-item {
  background: var(--card);
  border-left: 4px solid var(--accent);
  border-radius: 8px;
  padding: 10px 12px;
  font-size: 0.85rem;
}

.notif-item.ok {
  border-left-color: var(--ok);
}

.notif-item.run {
  border-left-color: var(--warn);
}

.notif-item.err {
  border-left-color: var(--err);
}

.meta {
  color: var(--muted);
  font-size: 0.75rem;
  margin-bottom: 4px;
}

pre {
  margin: 6px 0 0;
  white-space: pre-wrap;
  word-break: break-word;
  font-size: 0.78rem;
  color: #cbd5e1;
}
